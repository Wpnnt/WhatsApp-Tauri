{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "remote": {
    "urls": ["https://web.whatsapp.com/**"]
  },
  "permissions": [
    "core:default",
    "opener:default",
    "notification:default",
    "autostart:default",
    "global-shortcut:default",
    "core:tray:default",
    "dialog:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "http://**" },
        { "url": "https://**" }
      ]
    }
  ]
}
