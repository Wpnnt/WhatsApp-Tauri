{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Whatsapp Tauri",
  "version": "0.3.0",
  "identifier": "com.wpnnt.whatsapptauri",
  "build": {
    "devUrl": "https://web.whatsapp.com",
    "frontendDist": "icons"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Whatsapp Tauri",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "url": "https://web.whatsapp.com",
        "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "whatsapp"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "Wpnnt",
    "copyright": "Copyright © 2026 Wpnnt",
    "shortDescription": "Lightweight native WhatsApp Desktop client",
    "longDescription": "A lightweight, secure, and native WhatsApp Desktop client for Windows.",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": true
      }
    }
  }
}
